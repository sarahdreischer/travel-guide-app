# PostgreSQL connection string
# The citext extension must be enabled in the database before running migrations:
#   CREATE EXTENSION IF NOT EXISTS citext;
DATABASE_URL=postgresql://user:password@localhost:5432/travel_guide

# OpenAI API key (required for AI advice generation)
OPENAI_API_KEY=sk-your-key-here

# AI model (optional — defaults to gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

# AI rate limiting
# AI_MAX_CALLS_PER_MINUTE: burst limit — max AI calls per rolling minute (default: 3)
# AI_MAX_CALLS_PER_DAY: daily cap — max AI calls per rolling 24h (default: 50)
# AI_FAILURE_COOLDOWN_MINUTES: pause all calls for N minutes after a failure (default: 5)
AI_MAX_CALLS_PER_MINUTE=3
AI_MAX_CALLS_PER_DAY=50
AI_FAILURE_COOLDOWN_MINUTES=5

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required for sending password reset emails.
# Without these, emails are captured by Ethereal (dev only — preview URL in console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Trip Guide <noreply@tripguide.app>"

# Base URL used in email links (password reset, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Destination research (two-stage generation) ──────────────────────────────
# Stage 1 (destination research) retrieves external web evidence to establish
# STABLE destination facts, rather than trusting the LLM's pretrained knowledge.
# A generic Tavily-compatible search API is used when a key is set; otherwise
# the app falls back to keyless Wikipedia lookups (a reputable reference).
# WEB_SEARCH_API_KEY=your-tavily-or-compatible-key
# WEB_SEARCH_API_URL=https://api.tavily.com/search
# How long researched destination facts stay fresh before re-research (days).
# Facts are stable, so this defaults high; a destination can also be refreshed
# manually via refreshDestinationFactsAction.
# DESTINATION_FACTS_TTL_DAYS=180
# Per-call timeouts (ms) for the two AI stages.
# AI_RESEARCH_TIMEOUT_MS=60000
# AI_GUIDE_TIMEOUT_MS=90000
# AI_GUIDE_MAX_OUTPUT_TOKENS=8192
# Hard cap (seconds) for the "generating" loading screen before it redirects on
# whatever advice is available. Defaults to 30 so the preferred structured guide
# has time to land; it redirects sooner as soon as either the structured guide
# or the legacy advice is ready.
# GENERATING_TRIP_ADVICE_TIMEOUT_SECONDS=30

# ─── Unsplash (destination images) ────────────────────────────────────────────
# Fetches relevant travel photos per destination. Free tier: 50 requests/hour.
# Sign up at https://unsplash.com/developers to get an access key.
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
