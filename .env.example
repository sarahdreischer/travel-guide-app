# PostgreSQL connection string
# The citext extension must be enabled in the database before running migrations:
#   CREATE EXTENSION IF NOT EXISTS citext;
DATABASE_URL=postgresql://user:password@localhost:5432/travel_guide

# OpenAI API key (required for AI advice generation)
OPENAI_API_KEY=sk-your-key-here

# AI model (optional — defaults to gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

# AI rate limiting
# AI_MAX_CALLS_PER_WINDOW: max LLM calls per window (low for dev, higher in prod e.g. 100)
# AI_RATE_WINDOW_MINUTES: sliding window length in minutes (default: 60)
AI_MAX_CALLS_PER_WINDOW=2
AI_RATE_WINDOW_MINUTES=60
