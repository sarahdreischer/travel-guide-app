      "static/chunks/app/(app)/trip/new/page.js"
    ],
    "/(app)/destinations/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(app)/destinations/page.js"
    ],
    "/(app)/profile/page": [
      "static/chunks/webpack.js",
